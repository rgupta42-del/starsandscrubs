rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['rgupta42@gmail.com', 'vkudur@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function weekDoc(week) {
      return get(/databases/$(database)/documents/weeks/$(week)).data;
    }
    function beforeLock(week, game) {
      return request.time < weekDoc(week).locks[game];
    }
    // You manage a team if this device opened that team's personal link,
    // or (for phones set up before links existed) it claimed the team the old way.
    function ownsTeam(team) {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/devices/$(request.auth.uid))
          && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.team == team)
        || get(/databases/$(database)/documents/managers/$(team)).data.uid == request.auth.uid
      );
    }

    // Schedule, lock times and results: everyone reads, only commissioners write.
    match /weeks/{week} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Team names. A phone set up the old way can let go of its team; commissioners can change anything.
    match /managers/{team} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'claimedAt'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == null
      );
    }

    // Personal team links. Knowing a link's key is what proves you manage that team.
    // Anyone can look up one key they already have; only commissioners can list or change them.
    match /keys/{key} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Which team each device is signed in to. Created by opening a valid team link.
    match /devices/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['team', 'key', 'at'])
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/keys/$(request.resource.data.key)).data.team == request.resource.data.team;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // "Email me my link" requests. The autopilot reads them and emails the link to that address only.
    match /linkRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.at == request.time;
    }

    // Picks: private until lock. Commissioners see all; each team sees only its own.
    // One doc per pick: <team>__<week>__<game>. Only that team, only before that game locks.
    match /picks/{pickId} {
      allow get: if isAdmin() || ownsTeam(pickId.split('__')[0]);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (
        ownsTeam(request.resource.data.mgr)
        && request.resource.data.keys().hasOnly(['mgr', 'week', 'game', 'pick', 'at', 'loc'])
        && pickId == request.resource.data.mgr + '__' + request.resource.data.week + '__' + request.resource.data.game
        && request.resource.data.at == request.time
        && request.resource.data.pick in weekDoc(request.resource.data.week).teams[request.resource.data.game]
        && beforeLock(request.resource.data.week, request.resource.data.game)
      );
      allow delete: if isAdmin() || (
        ownsTeam(resource.data.mgr)
        && beforeLock(resource.data.week, resource.data.game)
      );
    }

    // Copies of picks published at each game's lock (by the autopilot). Everyone can read these.
    match /revealed/{pickId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit trail: append-only. Only commissioners can read it. Nobody can edit or delete entries.
    match /audit/{entry} {
      allow read: if isAdmin();
      allow create: if (isAdmin() && request.resource.data.by == 'commish' && request.resource.data.at == request.time) || (
        ownsTeam(request.resource.data.mgr)
        && request.resource.data.keys().hasOnly(['mgr', 'week', 'game', 'pick', 'action', 'at', 'loc', 'by'])
        && request.resource.data.by == 'player'
        && request.resource.data.at == request.time
        && beforeLock(request.resource.data.week, request.resource.data.game)
      );
      allow update, delete: if false;
    }
  }
}
